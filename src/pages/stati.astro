---
// Раздел «Статьи» (Паша 27.10: «добавь вкладки статьи для сайтов сухих и цветных смесей, но сами статьи пока
// не добавляй»). Статей пока нет — страница говорит об этом и ведёт в разделы сайта. Когда статьи появятся —
// их список вместо блока «Пока — разделы сайта» (тексты — только по данным производителей, правило 2 CLAUDE.md).
import Page from '../layouts/Page.astro';
import Container from '../components/layout/Container.astro';
import PageHead from '../components/site/PageHead.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { localPath } from '../lib/sites';
import { PAGES, GROUP_ORDER } from '../data/nav';
import { GROUPS, SECTIONS } from '../data/sections';
import { sectionCount } from '../lib/positions';

const groups = GROUP_ORDER.map((g) => ({
  title: GROUPS[g],
  sections: SECTIONS.filter((s) => s.group === g && sectionCount(s.slug) > 0),
}));
const links = [
  { href: `${localPath('sukhie')}#katalog`, title: 'Каталог по работам', note: 'кладка, стены и потолки, плитка, пол, фасад' },
  { href: PAGES.dostavka.href, title: 'Доставка', note: 'сроки, условия и что подготовить для расчёта' },
  { href: PAGES.kontakty.href, title: 'Контакты', note: 'два офиса продаж в Москве, часы работы' },
];
---

<Page
  title="Статьи о сухих строительных смесях"
  description="Статьи о сухих строительных смесях: как выбрать смесь под задачу, посчитать расход и подготовить основание. Раздел наполняется — пока смотрите каталог по работам."
  slug="stati"
>
  <PageHead
    trail={[{ label: 'Главная', href: localPath('sukhie') }, { label: 'Статьи' }]}
    title="Статьи о сухих строительных смесях"
    lead="Здесь будут статьи о сухих смесях: как выбрать смесь под задачу, посчитать расход, подготовить основание. Статей пока нет — а назначение и характеристики каждой смеси по данным производителей уже есть в каталоге."
  />

  <section class="st">
    <Container>
      <h2 class="h2">Пока — разделы сайта</h2>
      <ul class="st__links" role="list">
        {links.map((l) => (
          <li><a href={l.href}><b>{l.title}</b><span>{l.note}</span></a></li>
        ))}
      </ul>

      <h2 class="h2">Каталог смесей</h2>
      <div class="st__groups">
        {groups.map((gr) => (
          <div class="st__group">
            <p class="st__gtitle">{gr.title}</p>
            <ul role="list">
              {gr.sections.map((s) => (
                <li><a href={localPath('sukhie', s.slug)}><span>{s.label}</span><span class="st__n">{sectionCount(s.slug)}</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <CtaBand title="Нужен совет по смеси?" text="Назовите задачу и объём — подскажем смесь по данным производителя и посчитаем упаковки." />
</Page>

<style>
  .st { padding: var(--section-pad-md) 0; }
  .h2 { margin: 0 0 var(--space-5); font-size: var(--fs-h2); }
  .st__links { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-4); margin: 0 0 var(--space-8); padding: 0; list-style: none; }
  .st__links a { display: grid; gap: 6px; padding: var(--space-5); background: var(--color-bg-alt); border-radius: var(--radius); color: var(--color-text); text-decoration: none; }
  .st__links b { font-family: var(--font-head); font-size: var(--fs-h4); font-weight: 800; }
  .st__links span { color: var(--color-text-soft); font-size: var(--fs-small); }
  .st__links a:hover b { color: var(--color-accent-text); }
  .st__groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-6) var(--space-5); }
  .st__gtitle { margin: 0 0 var(--space-3); font-family: var(--font-head); font-weight: 800; font-size: var(--fs-h4); }
  .st__group ul { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .st__group a { display: flex; justify-content: space-between; gap: var(--space-3); padding: 8px 12px; font-weight: 600; color: var(--color-text); background: var(--color-surface-alt); border-radius: var(--radius-sm); text-decoration: none; }
  .st__group a:hover { color: var(--color-accent-text); }
  .st__n { color: var(--color-muted); font-weight: 500; }
</style>
