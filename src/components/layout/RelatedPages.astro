---
// Перелинковка: честные <a> вместо JS-инъекции, как на боевых.
// Годится и для «другие цвета/форматы», и для «другие формы плитки».
import type { RelatedItem } from '../../lib/types';

interface Props {
  items: RelatedItem[];
  title?: string;
  /** вид: cards — плитки с фото, list — компактный список ссылок, chips — таблетки-ссылки */
  variant?: 'cards' | 'list' | 'chips';
  columns?: 2 | 3 | 4;
  /** ссылка «вернуться в каталог/на главную» */
  back?: { href: string; label: string };
  class?: string;
}

const { items, title, variant = 'cards', columns = 4, back, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <nav class:list={['related', `related--${variant}`, className]} aria-label={title ?? 'Смотрите также'}>
      {title && <h2 class="related__title">{title}</h2>}

      <ul class="related__list" style={`--related-cols:${columns}`}>
        {items.map((item) => (
          <li class="related__item">
            <a class="related__link" href={item.href}>
              {variant === 'cards' && item.image && (
                <img class="related__image" src={item.image} alt={item.alt ?? ''} loading="lazy" />
              )}
              <span class="related__label">{item.label}</span>
              {item.note && <span class="related__note">{item.note}</span>}
            </a>
          </li>
        ))}
      </ul>

      {back && (
        <p class="related__back">
          <a href={back.href}>{back.label}</a>
        </p>
      )}
    </nav>
  )
}

<style>
  .related__title {
    margin-bottom: var(--space-5);
    font-size: var(--fs-h3);
  }

  .related__list {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related--list .related__list {
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .related__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-3);
    color: inherit;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .related__link:hover {
    opacity: 1;
    border-color: var(--color-brand);
    box-shadow: var(--shadow-card);
  }

  .related--list .related__link {
    flex-direction: row;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-border-soft);
    border-radius: 0;
  }

  .related--list .related__link:hover { box-shadow: none; }

  .related--chips .related__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .related--chips .related__link {
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 18px;
    font-size: var(--fs-small);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }

  .related--chips .related__link:hover {
    border-color: var(--color-brand);
    color: var(--color-accent-text);
    box-shadow: var(--shadow-card);
  }

  .related--chips .related__label { font-weight: 500; }

  .related__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .related__label { font-weight: 600; }

  .related__note {
    font-size: var(--fs-tiny);
    color: var(--color-muted);
  }

  .related__back { margin-top: var(--space-4); }

  @media (min-width: 768px) {
    .related__list { grid-template-columns: repeat(var(--related-cols, 4), minmax(0, 1fr)); }
    .related--list .related__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  }
</style>
