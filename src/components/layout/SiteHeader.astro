---
// Шапка: лого, меню (с выпадающими списками), телефон с режимом работы, кнопка звонка.
// На узком экране меню уезжает в панель под бургер — отдельной мобильной шапки нет.
import Container from './Container.astro';
import { getSite, localPath } from '../../lib/sites';
import type { FieldDef, NavItem, SiteKey } from '../../lib/types';

interface Props {
  site: SiteKey;
  nav?: NavItem[];
  phone?: { display: string; href: string };
  hours?: string;
  /** src — знак на светлой шапке; srcOnDark — он же для прозрачной шапки поверх
   *  первого экрана. Оба показываем разом и переключаем стилем: подменять src скриптом
   *  значит мигать пустым местом на каждой прокрутке. */
  logo?: { src?: string; srcOnDark?: string; text?: string; sub?: string; alt?: string; href?: string };
  /** кнопка звонка; null — не показывать.
   *  fields — состав формы в попапе (у ЖКЗ на боевом третье поле «Время звонка»). */
  cta?: { label: string; modalId?: string; href?: string; fields?: FieldDef[] } | null;
  sticky?: boolean;
  /** brand — шапка залита фирменным цветом (так у ЖКЗ) */
  /** brand — шапка залита фирменным цветом (так у ЖКЗ);
   *  over — прозрачная поверх первого экрана (язык дизайна RECKE, 15.09) */
  variant?: 'light' | 'brand' | 'over';
}

const {
  site,
  nav = [],
  phone,
  hours,
  logo,
  cta = { label: 'Позвонить' },
  sticky = false,
  variant = 'light',
} = Astro.props;

const config = getSite(site);
const tel = phone ?? config.phone;
const workHours = hours ?? config.hours;
const brand = { ...config.logo, ...logo };
const homeHref = brand.href ?? localPath(site);
---

<header class:list={['site-header', `site-header--${variant}`, sticky && 'site-header--sticky']}>
  <Container>
    <div class="site-header__inner">
      <a class="site-header__logo" href={homeHref}>
        {brand.src
          ? <Fragment>
              <img class="site-header__logo-img" src={brand.src} alt={brand.alt ?? config.brand} width="150" height="44" />
              {brand.srcOnDark && (
                <img class="site-header__logo-img site-header__logo-img--on-dark" src={brand.srcOnDark} alt="" aria-hidden="true" width="150" height="44" />
              )}
            </Fragment>
          : <span class="site-header__logo-text">
              <span class="site-header__mark" aria-hidden="true"></span>
              <span class="site-header__words">{brand.text ?? config.brand}{brand.sub && <small>{brand.sub}</small>}</span>
            </span>}
      </a>

      <button
        class="site-header__burger"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls={`nav-${site}`}
      >
        <span class="vh">Меню</span>
        <span class="site-header__burger-icon" aria-hidden="true"></span>
      </button>

      <div class="site-header__panel" id={`nav-${site}`} data-nav-panel>
        {nav.length > 0 && (
          <nav class="site-nav" aria-label="Основное меню">
            <ul class="site-nav__list">
              {nav.map((item) => (
                <li class:list={['site-nav__item', item.children?.length && 'site-nav__item--has-children']}>
                  {item.children?.length ? (
                    <Fragment>
                      <button class="site-nav__link" type="button" data-nav-sub aria-expanded="false">
                        {item.label}
                        <span class="site-nav__chevron" aria-hidden="true"></span>
                      </button>
                      <ul class="site-nav__sub">
                        {item.children.map((child) => (
                          <li>
                            <a
                              class="site-nav__sub-link"
                              href={child.href}
                              aria-current={child.current ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </Fragment>
                  ) : (
                    <a class="site-nav__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="site-header__contact">
          <a class="site-header__phone" href={tel.href}>{tel.display}</a>
          {workHours && <span class="site-header__hours">{workHours}</span>}
        </div>

        {cta && (
          <div class="site-header__cta">
            <a class="btn btn--primary btn--sm" href={cta.href ?? tel.href}>{cta.label}</a>
          </div>
        )}
      </div>
    </div>
  </Container>
  <!-- Подложка под открытой панелью на телефоне: тап по ней закрывает меню и не
       срабатывает по ссылке под ней. Видна только при открытом меню (< 1180 px). -->
  <div class="site-header__backdrop" data-nav-backdrop aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .site-header--brand {
    background: var(--color-brand);
    color: var(--color-on-brand);
    border-bottom-color: transparent;
  }

  /* прозрачная шапка поверх фотографии первого экрана: пока не прокрутили — без фона,
     как только страница поехала, is-scrolled возвращает обычный светлый фон */
  .site-header--over {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 60;
    background: transparent;
    border-bottom-color: transparent;
    color: var(--color-on-dark);
  }

  /* Кнопки исключены намеренно: у правила специфичность (0,3,1), а у .btn--primary
     в base.css — (0,1,0), поэтому шапка перекрашивала текст кнопки. На прокрученной
     белой шапке «Запросить» становилась чёрной по кирпичному — контраст 3,50:1. */
  .site-header--over :global(a:not(.btn)),
  .site-header--over :global(.site-header__phone),
  .site-header--over :global(.site-header__hours) { color: var(--color-on-dark); }

  /* Раскрытое меню поверх первого экрана получает плотный фон. Без этого у верха / и
     /bloki/ панель была прозрачной и пункты ложились прямо на заголовок первого экрана
     (аудит 04.10, R-14): читалось с трудом. Цвета — как у прокрученной шапки. */
  .site-header--over.is-menu-open:not(.is-scrolled) {
    background: var(--color-dark);
    border-bottom-color: rgb(255 255 255 / 0.12);
  }

  .site-header--over.is-scrolled {
    position: fixed;
    background: var(--color-bg);
    color: var(--color-text);
    border-bottom-color: var(--color-border);
  }

  .site-header--over.is-scrolled :global(a:not(.btn)),
  .site-header--over.is-scrolled :global(.site-header__phone),
  .site-header--over.is-scrolled :global(.site-header__hours) { color: var(--color-text); }

  .site-header--sticky {
    position: sticky;
    top: 0;
    transition: box-shadow var(--dur) var(--ease);
  }

  .site-header--sticky.is-scrolled { box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.22); }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding-block: var(--space-2);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
    color: inherit;
    text-decoration: none;
  }

  .site-header__logo :global(img) {
    max-height: 40px;
    width: auto;
  }

  /* Знак на прозрачной шапке поверх фотографии — светлый; как только шапка
     стала плотной (is-scrolled), возвращается обычный. Оба лежат в разметке,
     видимость решает CSS — без подмены src и без мигания. */
  .site-header__logo-img--on-dark { display: none; }
  .site-header--over:not(.is-scrolled) .site-header__logo-img { display: none; }
  .site-header--over:not(.is-scrolled) .site-header__logo-img--on-dark { display: block; }

  .site-header__logo-text {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.05;
  }
  .site-header__words { display: flex; flex-direction: column; }
  .site-header__words small { font-family: var(--font-body); font-size: 12px; font-weight: 500; color: var(--color-muted); letter-spacing: 0.02em; }
  /* Знак: мешок со смесью — тёмный силуэт и полоса акцента. Рисуется CSS, без файла. */
  .site-header__mark {
    flex: none;
    width: 26px;
    height: 32px;
    border-radius: 6px 6px 9px 9px;
    background:
      linear-gradient(var(--color-highlight, var(--color-brand)) 0 0) 0 13px / 100% 6px no-repeat,
      linear-gradient(var(--color-bg) 0 0) 9px 3px / 8px 3px no-repeat,
      var(--color-brand);
  }

  .site-header__burger {
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: inherit;
  }

  .site-header__burger-icon,
  .site-header__burger-icon::before,
  .site-header__burger-icon::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    content: '';
  }

  .site-header__burger-icon { transition: background-color var(--dur) var(--ease); }
  .site-header__burger-icon::before,
  .site-header__burger-icon::after { transition: transform var(--dur) var(--ease); }
  .site-header__burger-icon::before { transform: translateY(-6px); }
  .site-header__burger-icon::after { transform: translateY(4px); }

  /* Открытое меню: ≡ превращается в ×. Средняя полоса гаснет, крайние сходятся в центре
     (::before лежит на 0–2 px, ::after — на 2–4 px, отсюда translateY(-2px)). */
  .site-header__burger[aria-expanded='true'] .site-header__burger-icon { background-color: transparent; }
  .site-header__burger[aria-expanded='true'] .site-header__burger-icon::before { transform: rotate(45deg); }
  .site-header__burger[aria-expanded='true'] .site-header__burger-icon::after { transform: translateY(-2px) rotate(-45deg); }

  /* Панель — второй строкой шапки. Поля 6 px по бокам и сверху (с таким же отрицательным
     отступом) — чтобы рамка фокуса у пунктов не обрезалась краем прокрутки. */
  .site-header__panel {
    display: none;
    width: calc(100% + 12px);
    margin: -6px -6px 0;
    padding: 6px 6px var(--space-4);
  }

  /* Шапка липкая, панель в потоке: без ограничения высоты низ меню с раскрытым «Каталогом»
     уходил за экран (320×640 — «Контакты» и «Позвонить», 844×390 — 9 пунктов из 17),
     а прокрутка страницы его не поднимала. Панель прокручивается сама в пределах экрана;
     --nav-offset — всё в шапке, кроме панели: верхняя строка и нижние поля. */
  .site-header__panel[data-open] {
    --nav-offset: 71px;
    display: block;
    max-height: calc(100vh - var(--nav-offset));
    max-height: calc(100dvh - var(--nav-offset));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .site-header__backdrop { display: none; }

  @media (max-width: 1179.98px) {
    .site-header.is-menu-open .site-header__backdrop {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: block;
      height: 100vh;
      height: 100dvh;
      background: var(--overlay);
      touch-action: none;
    }
  }

  .site-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--tap);
    padding: var(--space-2) 0;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    color: inherit;
    text-align: left;
    text-decoration: none;
    background: none;
    border: 0;
  }

  .site-nav__link { position: relative; }

  .site-nav__link[aria-current='page'] { color: var(--color-accent-text); }

  @media (min-width: 1180px) {
    .site-nav__item > .site-nav__link::after {
      content: '';
      position: absolute;
      left: 0;
      right: 100%;
      bottom: 2px;
      height: 2px;
      background: var(--color-brand);
      transition: right var(--dur) var(--ease);
    }

    .site-nav__item > .site-nav__link:hover::after,
    .site-nav__item > .site-nav__link[aria-current='page']::after { right: 0; }
  }

  .site-nav__chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  .site-nav__sub {
    display: none;
    margin: 0 0 var(--space-2);
    padding: 0 0 0 var(--space-4);
    list-style: none;
  }

  .site-nav__item[data-open] > .site-nav__sub { display: block; }

  .site-nav__sub-link {
    display: block;
    padding: var(--space-2) 0;
    font-size: var(--fs-small);
    color: inherit;
    text-decoration: none;
  }

  .site-header__contact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-4);
  }

  .site-header__phone {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__hours {
    font-size: var(--fs-tiny);
    color: var(--color-muted);
  }

  .site-header--brand .site-header__hours { color: inherit; opacity: 0.8; }

  .site-header__cta { margin-top: var(--space-3); }

  @media (min-width: 1180px) {
    .site-header__burger { display: none; }

    /* одна строка: лого слева, меню и контакты справа — без переноса вторым этажом */
    .site-header__inner { flex-wrap: nowrap; }

    .site-header__panel {
      min-width: 0;
      display: flex !important;
      align-items: center;
      gap: var(--space-5);
      width: auto;
      max-height: none;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .site-nav__list { flex-direction: row; flex-wrap: nowrap; gap: 14px; min-width: 0; }

    .site-nav__link { font-size: 14px; }

    /* Выпадающий «Каталог» — поверх страницы на всех ширинах шапки в одну строку.
       Раньше абсолютное положение включалось только с 1400 px, и на 1180–1399 список
       раскрывался прямо в шапке (73 → 513 px). Открывает/закрывает скрипт атрибутом
       data-open: наведение, клик, Enter; закрывают уход мыши, клик мимо, Esc, Tab прочь. */
    .site-nav__item { position: relative; }

    .site-nav__sub {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 5;
      min-width: 220px;
      margin: 0;
      padding: var(--space-3);
      background: var(--color-surface);
      color: var(--color-text);
      border: 1px solid var(--color-border-soft);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
    }

    .site-header__phone { font-size: 17px; }

    .site-header__hours { display: none; }
  }

  @media (min-width: 1400px) {
    .site-nav__list { gap: 18px; }
    .site-nav__link { font-size: 15px; }
    .site-header__phone { font-size: 19px; }
    .site-header__hours { display: block; }

    .site-nav__link { min-height: 0; padding: var(--space-2) 0; white-space: nowrap; }

    .site-header__contact { margin-top: 0; text-align: right; }
    .site-header__cta { margin-top: 0; }
  }
</style>

<script>
  import { lockScroll, unlockScroll } from '../../lib/scroll-lock';

  // Бургер и выпадающие пункты. Делегирование, одна привязка на страницу.
  // Состояние — только атрибуты: data-open у панели и у пункта меню, aria-expanded у кнопок.
  const DESKTOP = window.matchMedia('(min-width: 1180px)');

  function toggleOf(panel: HTMLElement) {
    return document.querySelector<HTMLElement>(`[data-nav-toggle][aria-controls="${panel.id}"]`);
  }

  // Панель на телефоне: открыта — страница под ней стоит, бургер показывает × и
  // называется «Закрыть меню».
  function setPanel(panel: HTMLElement, open: boolean) {
    if (panel.hasAttribute('data-open') === open) return;
    panel.toggleAttribute('data-open', open);
    const toggle = toggleOf(panel);
    toggle?.setAttribute('aria-expanded', String(open));
    if (open) toggle?.setAttribute('aria-label', 'Закрыть меню');
    else toggle?.removeAttribute('aria-label');
    panel.closest('.site-header')?.classList.toggle('is-menu-open', open);
    if (open) {
      panel.scrollTop = 0;
      lockScroll('nav');
    } else {
      unlockScroll('nav');
    }
  }

  function openPanels() {
    return document.querySelectorAll<HTMLElement>('[data-nav-panel][data-open]');
  }

  function setSub(item: HTMLElement, open: boolean) {
    item.toggleAttribute('data-open', open);
    item.querySelector('[data-nav-sub]')?.setAttribute('aria-expanded', String(open));
    if (!open) delete item.dataset.hover;
  }

  function closeSubs(except?: Element | null) {
    document.querySelectorAll<HTMLElement>('.site-nav__item[data-open]').forEach((item) => {
      if (item !== except) setSub(item, false);
    });
  }

  if (!(window as any).__ktNavInit) {
    (window as any).__ktNavInit = true;

    // Тап по подложке закрывает меню; ссылка под подложкой при этом не срабатывает.
    // Слушатель прямо на элементе: на iOS клик по «некликабельному» узлу до document не доходит.
    document.querySelectorAll<HTMLElement>('[data-nav-backdrop]').forEach((backdrop) => {
      backdrop.addEventListener('click', (event) => {
        event.preventDefault();
        openPanels().forEach((panel) => setPanel(panel, false));
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      const toggle = target.closest<HTMLElement>('[data-nav-toggle]');
      if (toggle) {
        const panel = document.getElementById(toggle.getAttribute('aria-controls') || '');
        if (panel) setPanel(panel, !panel.hasAttribute('data-open'));
        return;
      }

      // Клик вне панели (и не по бургеру) закрывает открытое меню.
      if (!target.closest('[data-nav-panel]')) openPanels().forEach((panel) => setPanel(panel, false));

      // Тап по ссылке в раскрытом меню закрывает панель. Раньше она закрывалась только
      // бургером и Escape: после тапа «Доставка» страница уезжала к разделу, а панель
      // оставалась открытой и закрывала его заголовок и первую карточку (аудит 04.10, R-15).
      const link = target.closest<HTMLAnchorElement>('[data-nav-panel] a[href]');
      if (link) {
        const panel = link.closest<HTMLElement>('[data-nav-panel]');
        if (panel) setPanel(panel, false);
      }

      const sub = target.closest<HTMLElement>('[data-nav-sub]');
      const item = sub?.closest<HTMLElement>('.site-nav__item') ?? null;
      // На ПК клик мимо раскрытого «Каталога» его закрывает.
      if (DESKTOP.matches) closeSubs(item);
      if (sub && item) {
        // Открыт наведением — клик его «закрепляет», а не закрывает: иначе меню,
        // раскрывшееся под мышью, схлопывалось бы от первого же клика.
        if (item.dataset.hover) delete item.dataset.hover;
        else setSub(item, !item.hasAttribute('data-open'));
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const panels = openPanels();
      if (panels.length) {
        panels.forEach((panel) => {
          setPanel(panel, false);
          toggleOf(panel)?.focus();
        });
        return;
      }
      if (!DESKTOP.matches) return;
      document.querySelectorAll<HTMLElement>('.site-nav__item[data-open]').forEach((item) => {
        const hadFocus = item.contains(document.activeElement);
        setSub(item, false);
        if (hadFocus) item.querySelector<HTMLElement>('[data-nav-sub]')?.focus();
      });
    });

    // ПК: наведение мыши раскрывает «Каталог», уход мыши закрывает; фокус ушёл из пункта
    // на другой элемент (Tab дальше или назад) — тоже закрывает.
    document.querySelectorAll<HTMLElement>('.site-nav__item--has-children').forEach((item) => {
      item.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse' || !DESKTOP.matches || item.hasAttribute('data-open')) return;
        closeSubs(item);
        setSub(item, true);
        item.dataset.hover = '1';
      });
      item.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse' && DESKTOP.matches) setSub(item, false);
      });
      // relatedTarget пуст при клике по «пустому» месту — это решает обработчик клика выше,
      // иначе клик по полю самого списка закрывал бы его.
      item.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (DESKTOP.matches && next && !item.contains(next)) setSub(item, false);
      });
    });

    // Переход через 1180 px (поворот планшета, окно ПК): мобильная панель и раскрытые
    // списки сбрасываются — иначе на ПК осталась бы заблокированная прокрутка без бургера.
    DESKTOP.addEventListener('change', () => {
      openPanels().forEach((panel) => setPanel(panel, false));
      closeSubs();
    });

    // Тень липкой шапки после начала прокрутки
    const stickyHeader = document.querySelector('.site-header--sticky, .site-header--over');
    if (stickyHeader) {
      const onScroll = () => stickyHeader.classList.toggle('is-scrolled', window.scrollY > 4);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>
