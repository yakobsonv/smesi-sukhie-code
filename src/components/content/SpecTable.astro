---
// Характеристики парами «показатель — значение».
// На боевых сайтах таблиц нет — характеристики набраны отдельными блоками по координатам;
// здесь это нормальная таблица, которая на телефоне превращается в список.
import type { SpecRow } from '../../lib/types';

interface Props {
  rows: SpecRow[];
  title?: string;
  caption?: string;
  /** 1 — одна колонка пар, 2 — две (для длинных списков) */
  columns?: 1 | 2;
  note?: string;
  class?: string;
}

const { rows, title, caption, columns = 1, note, class: className } = Astro.props;
---

{
  rows.length > 0 && (
    <div class:list={['specs', columns === 2 && 'specs--two', className]}>
      {title && <h3 class="specs__title">{title}</h3>}

      <table class="specs__table">
        {caption && <caption class="specs__caption">{caption}</caption>}
        <tbody>
          {rows.map((row) => (
            <tr class="specs__row">
              <th class="specs__label" scope="row">{row.label}</th>
              <td class="specs__value">
                {row.value}{row.unit ? ` ${row.unit}` : ''}
                {row.note && <span class="specs__note">{row.note}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {note && <p class="specs__footnote">{note}</p>}
    </div>
  )
}

<style>
  .specs__title {
    margin-bottom: var(--space-4);
    font-size: var(--fs-h3);
  }

  .specs__table {
    width: 100%;
    border-collapse: collapse;
  }

  .specs__caption {
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-muted);
    text-align: left;
  }

  .specs__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .specs__label {
    flex: 1 1 45%;
    font-weight: 500;
    color: var(--color-text-soft);
    text-align: left;
  }

  .specs__value {
    flex: 1 1 45%;
    font-weight: 700;
  }

  .specs__note {
    display: block;
    font-size: var(--fs-tiny);
    font-weight: 400;
    color: var(--color-muted);
  }

  .specs__footnote {
    margin-top: var(--space-3);
    font-size: var(--fs-tiny);
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .specs--two .specs__table tbody {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
  }
</style>
