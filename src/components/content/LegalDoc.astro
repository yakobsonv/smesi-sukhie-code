---
// Правовой документ: Положение об обработке персональных данных или Согласие.
// Текст приходит блоками из src/data/legal.ts — это дословные документы клиента,
// снятые с боевого Стелларда 08.09.2026. Здесь только вёрстка: читаемая колонка,
// нормальные заголовки и списки вместо сплошной простыни конструктора.
import Container from '../layout/Container.astro';
import type { LegalBlock } from '../../data/legal';

interface Props {
  blocks: LegalBlock[];
  /** дата снятия текста — показываем честно, чтобы было видно, насколько документ свежий */
  source?: string;
}

const { blocks, source } = Astro.props;

// подряд идущие <li> собираем в один список
type Node = { kind: 'block'; block: LegalBlock } | { kind: 'list'; items: string[] };
const nodes: Node[] = [];
for (const block of blocks) {
  const last = nodes[nodes.length - 1];
  if (block.tag === 'li' && last && last.kind === 'list') last.items.push(block.text);
  else if (block.tag === 'li') nodes.push({ kind: 'list', items: [block.text] });
  else nodes.push({ kind: 'block', block });
}
---

<article class="legal">
  <Container width="narrow">
    {nodes.map((node) =>
      node.kind === 'list' ? (
        <ul class="legal__list">{node.items.map((item) => <li>{item}</li>)}</ul>
      ) : node.block.tag === 'h1' ? (
        <h1 class="legal__h1">{node.block.text}</h1>
      ) : node.block.tag === 'h2' ? (
        <h2 class="legal__h2">{node.block.text}</h2>
      ) : node.block.tag === 'h3' ? (
        <h3 class="legal__h3">{node.block.text}</h3>
      ) : (
        <p class="legal__p">{node.block.text}</p>
      )
    )}

    {source && <p class="legal__source">{source}</p>}
  </Container>
</article>

<style>
  .legal { padding-block: var(--space-8) var(--space-9); }

  .legal__h1 {
    margin-bottom: var(--space-6);
    font-size: var(--fs-h1);
    line-height: 1.15;
    /* У RECKE --fs-h1 доходит до 112 px, и на телефоне длинное слово
       («персональных») не влезало в строку: сам блок оставался 358 px, но глифы
       выходили за экран и давали горизонтальную прокрутку всей страницы на
       /regulation/ и /consent/. Поэтому переносим и на телефоне уменьшаем кегль. */
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  @media (max-width: 619px) {
    .legal__h1 { font-size: var(--fs-h2); }
  }

  .legal__h2 {
    margin: var(--space-7) 0 var(--space-4);
    font-size: var(--fs-h3);
  }

  .legal__h3 {
    margin: var(--space-5) 0 var(--space-3);
    font-size: var(--fs-lead);
  }

  .legal__p { margin-bottom: var(--space-4); }

  .legal__list {
    margin: 0 0 var(--space-4);
    padding-left: 1.3em;
    list-style: disc;
  }

  .legal__list li { margin-bottom: var(--space-2); }

  .legal__p,
  .legal__list li {
    max-width: 78ch;
    color: var(--color-text-soft);
  }

  .legal__source {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
</style>
