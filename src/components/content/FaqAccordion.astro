---
// Вопросы и ответы. На боевых сайтах текст ответов живёт ТОЛЬКО в микроразметке,
// а HTML рисует скрипт. Здесь наоборот: один список данных → и видимый текст, и FAQPage.
// Умеет показать первые N вопросов со ссылкой на полную страницу.
import { faqJsonLd } from '../../lib/seo';
import { limit as take, toId } from '../../lib/format';
import type { FaqItem, SiteKey } from '../../lib/types';

interface Props {
  items: FaqItem[];
  title?: string;
  /** сколько вопросов показать (остальные — на полной странице) */
  limit?: number;
  /** ссылка на страницу со всеми вопросами */
  moreHref?: string;
  moreLabel?: string;
  /** раскрыть первый вопрос */
  openFirst?: boolean;
  columns?: 1 | 2;
  /** отдавать FAQPage по показанным вопросам */
  jsonLd?: boolean;
  site?: SiteKey;
  slug?: string;
  class?: string;
}

const {
  items,
  title,
  limit: max,
  moreHref,
  moreLabel = 'Все вопросы и ответы',
  openFirst = false,
  columns = 1,
  jsonLd = true,
  site,
  slug = '',
  class: className,
} = Astro.props;

const shown = take(items, max);
const hiddenCount = items.length - shown.length;
// В микроразметку идут ровно те вопросы, что видны на странице.
const data = jsonLd ? faqJsonLd(shown, site, slug) : null;
---

{
  shown.length > 0 && (
    <div class:list={['faq', columns === 2 && 'faq--two', className]}>
      {title && <h2 class="faq__title">{title}</h2>}

      <div class="faq__list">
        {shown.map((item, index) => (
          <details class="faq__item" open={openFirst && index === 0} id={`q-${toId(item.q)}`}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__sign" aria-hidden="true"></span>
            </summary>
            <div class="faq__a" set:html={item.a} />
          </details>
        ))}
      </div>

      {moreHref && hiddenCount > 0 && (
        <p class="faq__more">
          <a class="btn btn--ghost" href={moreHref}>{moreLabel} ({items.length})</a>
        </p>
      )}

      {data && <script type="application/ld+json" set:html={JSON.stringify(data)} />}
    </div>
  )
}

<style>
  .faq__title {
    margin-bottom: var(--space-5);
  }

  .faq__list {
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    font-family: var(--font-head);
    font-size: var(--fs-h4);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { opacity: 0.7; }

  /* «плюс» из двух брусков — как на боевых спойлерах */
  .faq__sign {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 0.35em;
  }

  .faq__sign::before,
  .faq__sign::after {
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
    background: currentColor;
    content: '';
    transition: transform var(--dur) var(--ease);
  }

  .faq__sign::after { transform: rotate(90deg); }
  .faq__item[open] .faq__sign::after { transform: rotate(0deg); }

  .faq__a {
    padding: 0 0 var(--space-5);
    max-width: 72ch;
    color: var(--color-text-soft);
  }

  .faq__a :global(p + p) { margin-top: var(--space-3); }
  .faq__a :global(ul) { padding-left: 1.25em; }

  .faq__more { margin-top: var(--space-5); }

  @media (min-width: 900px) {
    .faq--two .faq__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
  }
</style>
