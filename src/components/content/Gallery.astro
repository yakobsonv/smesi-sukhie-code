---
// Галерея фото с лайтбоксом на нативном <dialog>. Без библиотек.
// alt обязателен у каждого фото: на боевых у всех 12 фото Оскола он одинаковый — так не переносим.
import type { ImageItem } from '../../lib/types';

interface Props {
  items: ImageItem[];
  columns?: 2 | 3 | 4;
  lightbox?: boolean;
  /** strip — горизонтальная лента со scroll-snap и стрелками вместо сетки */
  variant?: 'grid' | 'strip';
  title?: string;
  class?: string;
}

const { items, columns = 3, lightbox = true, variant = 'grid', title, class: className } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---

{
  items.length > 0 && (
    <div class:list={['gallery', variant === 'strip' && 'gallery--strip', className]} style={`--gallery-cols:${columns}`} data-gallery={lightbox ? galleryId : undefined}>
      {variant === 'strip' && (
        <div class="gallery__nav" aria-hidden="true">
          <button class="gallery__navbtn" type="button" data-strip-prev tabindex="-1">‹</button>
          <button class="gallery__navbtn" type="button" data-strip-next tabindex="-1">›</button>
        </div>
      )}
      {title && <h2 class="gallery__title">{title}</h2>}

      <ul class="gallery__list">
        {items.map((item, index) => (
          <li class="gallery__item">
            {lightbox ? (
              <button class="gallery__button" type="button" data-gallery-open={index}>
                <img
                  class="gallery__image"
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
                {item.caption && <span class="gallery__caption">{item.caption}</span>}
              </button>
            ) : (
              <figure class="gallery__figure">
                <img
                  class="gallery__image"
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
                {item.caption && <figcaption class="gallery__caption">{item.caption}</figcaption>}
              </figure>
            )}
          </li>
        ))}
      </ul>

      {lightbox && (
        <dialog class="lightbox" data-gallery-dialog>
          <button class="lightbox__close" type="button" data-gallery-close aria-label="Закрыть">×</button>
          <button class="lightbox__nav lightbox__nav--prev" type="button" data-gallery-prev aria-label="Предыдущее фото">‹</button>
          {/* без атрибута src: пустой src="" браузер считает адресом самой страницы
              и грузит HTML как картинку. Настоящий src проставляет скрипт при открытии. */}
          <img class="lightbox__image" data-gallery-image alt="" />
          <p class="lightbox__caption" data-gallery-caption></p>
          <button class="lightbox__nav lightbox__nav--next" type="button" data-gallery-next aria-label="Следующее фото">›</button>
        </dialog>
      )}
    </div>
  )
}

<style>
  .gallery__title { margin-bottom: var(--space-5); }

  .gallery__list {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__button,
  .gallery__figure {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    text-align: left;
  }

  .gallery__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    transition: transform var(--dur) var(--ease);
  }

  .gallery__button:hover .gallery__image { transform: scale(1.02); }

  .gallery__caption {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--fs-tiny);
    color: var(--color-muted);
  }

  .lightbox {
    width: min(1100px, 96vw);
    max-height: 92vh;
    padding: var(--space-4);
    border: 0;
    border-radius: var(--radius);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .lightbox::backdrop { background: rgb(0 0 0 / 0.8); }

  .lightbox__image {
    width: 100%;
    max-height: 76vh;
    object-fit: contain;
    margin-inline: auto;
  }

  .lightbox__caption {
    margin-top: var(--space-3);
    text-align: center;
    font-size: var(--fs-small);
    opacity: 0.85;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    font-size: 30px;
    line-height: 1;
    color: inherit;
    background: rgb(0 0 0 / 0.35);
    border: 0;
    border-radius: 50%;
  }

  .lightbox__close { top: 8px; right: 8px; }
  .lightbox__nav--prev { top: 50%; left: 8px; transform: translateY(-50%); }
  .lightbox__nav--next { top: 50%; right: 8px; transform: translateY(-50%); }

  @media (min-width: 900px) {
    .gallery__list { grid-template-columns: repeat(var(--gallery-cols, 3), minmax(0, 1fr)); }
  }

  /* ——— вариант «лента»: горизонтальный scroll-snap, крупные кадры, стрелки */
  .gallery--strip { position: relative; }

  .gallery--strip .gallery__list {
    display: flex;
    gap: var(--grid-gap);
    overflow-x: auto;
    padding-bottom: var(--space-3);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .gallery--strip .gallery__item {
    flex: 0 0 auto;
    width: min(78vw, 460px);
    scroll-snap-align: start;
  }

  .gallery--strip .gallery__image {
    aspect-ratio: 4 / 3;
    height: auto;
  }

  .gallery__nav {
    position: absolute;
    top: -64px;
    right: 0;
    display: flex;
    gap: var(--space-2);
  }

  .gallery__navbtn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 24px;
    line-height: 1;
    color: inherit;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity var(--dur) var(--ease), background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .gallery__navbtn:hover {
    opacity: 1;
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #fff;
  }
</style>

<script>
  // Лайтбокс: открытие по клику, стрелки, Escape закрывает сам <dialog>.
  if (!(window as any).__ktGalleryInit) {
    (window as any).__ktGalleryInit = true;

    const show = (gallery: HTMLElement, index: number) => {
      const buttons = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-open]'));
      if (!buttons.length) return;
      const safe = (index + buttons.length) % buttons.length;
      const source = buttons[safe].querySelector('img');
      const dialog = gallery.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
      const image = gallery.querySelector<HTMLImageElement>('[data-gallery-image]');
      const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
      if (!dialog || !image || !source) return;

      // src ставим только когда он реально есть — иначе снимаем атрибут,
      // чтобы не превратить его в ссылку на саму страницу.
      const nextSrc = source.getAttribute('src');
      if (nextSrc) image.setAttribute('src', nextSrc);
      else image.removeAttribute('src');
      image.alt = source.getAttribute('alt') || '';
      if (caption) caption.textContent = source.getAttribute('alt') || '';
      gallery.dataset.current = String(safe);
      if (!dialog.open) dialog.showModal();
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const gallery = target.closest<HTMLElement>('[data-gallery]');
      if (!gallery) return;

      const opener = target.closest<HTMLElement>('[data-gallery-open]');
      if (opener) {
        show(gallery, Number(opener.dataset.galleryOpen));
        return;
      }

      const current = Number(gallery.dataset.current || 0);
      if (target.closest('[data-gallery-next]')) show(gallery, current + 1);
      else if (target.closest('[data-gallery-prev]')) show(gallery, current - 1);
      else if (target.closest('[data-gallery-close]')) gallery.querySelector<HTMLDialogElement>('[data-gallery-dialog]')?.close();
    });

    document.addEventListener('keydown', (event) => {
      const dialog = document.querySelector<HTMLDialogElement>('dialog[data-gallery-dialog][open]');
      if (!dialog) return;
      const gallery = dialog.closest<HTMLElement>('[data-gallery]');
      if (!gallery) return;
      const current = Number(gallery.dataset.current || 0);
      if (event.key === 'ArrowRight') show(gallery, current + 1);
      if (event.key === 'ArrowLeft') show(gallery, current - 1);
    });

    // стрелки ленты: прокрутка на ширину кадра
    document.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>('[data-strip-prev], [data-strip-next]');
      if (!btn) return;
      const list = btn.closest('.gallery--strip')?.querySelector('.gallery__list');
      if (!list) return;
      const item = list.querySelector<HTMLElement>('.gallery__item');
      const step = (item?.offsetWidth || 400) + 20;
      list.scrollBy({ left: btn.hasAttribute('data-strip-next') ? step : -step, behavior: 'smooth' });
    });
  }
</script>
