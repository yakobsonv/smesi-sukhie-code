---
// Фильтр позиций страницы по бренду (и, на плиточном клее, по «керамограниту и крупному формату»).
// Работает без перезагрузки: прячет строки [data-pos-item] и пустые секции [data-part].
// Без JS фильтр не нужен — все позиции видны.
interface Props {
  brands: string[];
  ceramic?: boolean;
}
const { brands, ceramic = false } = Astro.props;
---

{(brands.length > 1 || ceramic) && (
  <div class="bf" data-bf role="group" aria-label="Фильтр позиций">
    {brands.length > 1 && (
      <div class="bf__row">
        <button type="button" class="bf__chip is-on" data-bf-brand="" aria-pressed="true">Все бренды</button>
        {brands.map((b) => <button type="button" class="bf__chip" data-bf-brand={b} aria-pressed="false">{b}</button>)}
      </div>
    )}
    {ceramic && (
      <label class="bf__check"><input type="checkbox" data-bf-ceramic /> Керамогранит и крупный формат — по назначению у производителя</label>
    )}
    <p class="bf__count" data-bf-count aria-live="polite"></p>
  </div>
)}

<style>
  .bf { display: grid; gap: var(--space-3); margin: 0 0 var(--space-5); }
  .bf__row { display: flex; flex-wrap: wrap; gap: 8px; }
  .bf__chip {
    min-height: var(--tap);
    padding: 8px 16px;
    font: inherit;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .bf__chip.is-on { color: var(--color-on-brand); background: var(--color-brand); border-color: var(--color-brand); }
  .bf__check { display: flex; align-items: center; gap: 10px; font-size: var(--fs-small); cursor: pointer; }
  .bf__check input { width: 20px; height: 20px; accent-color: var(--color-brand); }
  .bf__count { margin: 0; font-size: var(--fs-tiny); color: var(--color-muted); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-bf]');
  if (root) {
    let brand = '';
    let ceramic = false;
    const count = root.querySelector<HTMLElement>('[data-bf-count]');
    const word = (n: number) => { const a = n % 10, b = n % 100; return a === 1 && b !== 11 ? 'позиция' : a >= 2 && a <= 4 && (b < 12 || b > 14) ? 'позиции' : 'позиций'; };
    const rows = [...document.querySelectorAll<HTMLElement>('[data-pos-item]')];
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      let shown = 0;
      rows.forEach((li) => {
        const ok = (!brand || li.dataset.brand === brand) && (!ceramic || li.dataset.ceramic === '1');
        li.hidden = !ok;
        if (ok) shown++;
      });
      document.querySelectorAll<HTMLElement>('[data-part]').forEach((part) => {
        part.hidden = !part.querySelector('[data-pos-item]:not([hidden])');
      });
      // Показанные фильтром строки видны сразу, не дожидаясь появления при прокрутке (Reveal,
      // [data-reveal-items]): без этого строка снизу списка, поднявшаяся на экран, оставалась прозрачной.
      const late = rows.filter((li) => !li.hidden && !li.classList.contains('is-revealed'));
      late.forEach((li) => { li.style.transition = 'none'; li.classList.add('is-revealed'); });
      if (late.length) requestAnimationFrame(() => requestAnimationFrame(() => late.forEach((li) => { li.style.transition = ''; })));
      if (count) count.textContent = brand || ceramic ? `Показано: ${shown} ${word(shown)}` : '';
    };

    // Плавная смена списка (без блокировки кликов). Состояние списка и счётчик меняются сразу.
    // - Оставшиеся строки переезжают на новые места (240 мс) — все, и те, что были за краем экрана:
    //   ни одна не проявляется на месте, через которое едет другая. Переезжающие — над остальными (z-index 1).
    // - Новые строки (не подходили под прошлый фильтр) проявляются на месте с подъёмом на 6 px.
    // - Ушедшие тают и опускаются на 6 px (копия на старом месте, 200 мс) — только в пределах своего списка;
    //   у целиком скрытой секции копий нет (она уходит вместе с заголовком).
    // Быстрый повторный клик: место и прозрачность строк замеряются с текущим сдвигом, затем прошлые
    // анимации и копии снимаются — движение продолжается с того места, где строка была на экране;
    // строка, которая ещё таяла копией и снова подходит под фильтр, едет с места копии (копия ещё заметна)
    // или проявляется на своём месте (копия почти растаяла). Полупрозрачные строки не переезжают — едут только
    // непрозрачные, поверх остальных: полупрозрачная никогда не ложится поверх другой строки.
    const EASE = 'cubic-bezier(0.4, 0, 0.2, 1)';
    const near = (r: DOMRect) => r.bottom > -100 && r.top < window.innerHeight + 100;
    const crosses = (a: DOMRect, b: DOMRect) => Math.min(a.top, b.top) < window.innerHeight + 100 && Math.max(a.bottom, b.bottom) > -100;
    const ghosts = new Map<HTMLElement, HTMLElement>(); // строка → её тающая копия
    const apply = (animate = false) => {
      const anim = animate && motionOk && 'animate' in Element.prototype;
      const before = new Map<HTMLElement, { r: DOMRect; op: number }>();
      if (anim) rows.forEach((li) => { if (!li.hidden) before.set(li, { r: li.getBoundingClientRect(), op: +getComputedStyle(li).opacity }); });
      const back = new Map<HTMLElement, { r: DOMRect; op: number }>();
      ghosts.forEach((g, li) => {
        if (anim) back.set(li, { r: g.getBoundingClientRect(), op: +getComputedStyle(g).opacity });
        g.remove();
      });
      ghosts.clear();
      if ('getAnimations' in Element.prototype) rows.forEach((li) => li.getAnimations().forEach((a) => a.cancel()));
      update();
      if (!anim) return;
      before.forEach(({ r, op }, li) => {
        if (!li.hidden || op < 0.05 || !near(r)) return;
        if (li.closest<HTMLElement>('[data-part]')?.hidden) return;
        const list = li.parentElement?.getBoundingClientRect();
        if (!list) return;
        // копия видна только в пределах своего списка: за ним — заголовок и строки соседней секции
        const cutTop = Math.max(0, list.top - r.top);
        const cutBottom = Math.max(0, r.bottom - list.bottom);
        if (cutTop + cutBottom >= r.height) return;
        // копия без id и data-атрибутов (её не находят скрипты и проверки), мимо кликов, ПОД строками
        // (z-index −1): где на её место уже встала другая строка, текст не двоится — копия видна только в пустоте
        const ghost = li.cloneNode(true) as HTMLElement;
        for (const el of [ghost, ...ghost.querySelectorAll<HTMLElement>('[id], [data-pos]')]) { el.removeAttribute('id'); el.removeAttribute('data-pos'); }
        ghost.removeAttribute('data-pos-item');
        ghost.removeAttribute('data-brand');
        ghost.removeAttribute('data-ceramic');
        ghost.hidden = false;
        ghost.setAttribute('aria-hidden', 'true');
        ghost.inert = true;
        Object.assign(ghost.style, { position: 'absolute', left: `${r.left + window.scrollX}px`, top: `${r.top + window.scrollY}px`, width: `${r.width}px`, height: `${r.height}px`, margin: '0', zIndex: '-1', pointerEvents: 'none', transition: 'none', opacity: String(op), clipPath: cutTop || cutBottom ? `inset(${cutTop}px 0 ${cutBottom}px 0)` : '' });
        document.body.append(ghost);
        ghosts.set(li, ghost);
        ghost.animate([{ opacity: op, translate: '0 0' }, { opacity: 0, translate: '0 6px' }], { duration: 200, easing: EASE, fill: 'forwards' }).finished
          .catch(() => {})
          .finally(() => { ghost.remove(); if (ghosts.get(li) === ghost) ghosts.delete(li); });
      });
      rows.forEach((li) => {
        if (li.hidden) return;
        const r = li.getBoundingClientRect();
        const was = back.get(li);
        const old = before.get(li) ?? (was && was.op >= 0.5 ? was : undefined);
        if (old) {
          const dy = old.r.top - r.top;
          if (Math.abs(dy) > 1 && crosses(old.r, r)) li.animate([{ translate: `0 ${dy}px`, zIndex: 1 }, { translate: '0 0', zIndex: 1 }], { duration: 240, easing: EASE });
          else if (old.op < 0.95 && near(r)) li.animate([{ opacity: old.op }, { opacity: 1 }], { duration: 240, easing: EASE });
        } else if (near(r)) {
          // новая строка (или почти растаявшая копия) — проявляется на своём месте. Если на этом месте ещё
          // тает копия ушедшей строки (прямое переключение бренд → бренд), ждём её: иначе ~0,1 с видны
          // два текста сразу (QA 21.10)
          const overGhost = [...ghosts.values()].some((g) => { const gr = g.getBoundingClientRect(); return gr.bottom > r.top + 1 && gr.top < r.bottom - 1; });
          li.animate([{ opacity: was ? was.op : 0, translate: '0 6px' }, { opacity: 1, translate: '0 0' }], { duration: 240, delay: overGhost ? 190 : 0, fill: 'backwards', easing: EASE });
        }
      });
    };

    root.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-bf-brand]');
      if (!chip) return;
      brand = chip.dataset.bfBrand || '';
      root.querySelectorAll('[data-bf-brand]').forEach((c) => {
        c.classList.toggle('is-on', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      apply(true);
    });
    const check = root.querySelector<HTMLInputElement>('[data-bf-ceramic]');
    check?.addEventListener('change', () => {
      ceramic = check.checked;
      apply(true);
    });
    // Галочку браузер восстанавливает сам (обновление, «Назад», страница из bfcache), а
    // состояние скрипта начиналось с false: галочка стояла, а список показывал всё.
    // Берём состояние с самой галочки — при запуске и при каждом показе страницы.
    const sync = () => {
      if (!check || check.checked === ceramic) return;
      ceramic = check.checked;
      apply();
    };
    sync();
    window.addEventListener('pageshow', sync);
  }
</script>
