---
// Фильтр позиций страницы по бренду (и, на плиточном клее, по «керамограниту и крупному формату»).
// Работает без перезагрузки: прячет строки [data-pos-item] и пустые секции [data-part].
// Без JS фильтр не нужен — все позиции видны.
interface Props {
  brands: string[];
  ceramic?: boolean;
}
const { brands, ceramic = false } = Astro.props;
---

{(brands.length > 1 || ceramic) && (
  <div class="bf" data-bf role="group" aria-label="Фильтр позиций">
    {brands.length > 1 && (
      <div class="bf__row">
        <button type="button" class="bf__chip is-on" data-bf-brand="" aria-pressed="true">Все бренды</button>
        {brands.map((b) => <button type="button" class="bf__chip" data-bf-brand={b} aria-pressed="false">{b}</button>)}
      </div>
    )}
    {ceramic && (
      <label class="bf__check"><input type="checkbox" data-bf-ceramic /> Керамогранит и крупный формат — по назначению у производителя</label>
    )}
    <p class="bf__count" data-bf-count aria-live="polite"></p>
  </div>
)}

<style>
  .bf { display: grid; gap: var(--space-3); margin: 0 0 var(--space-5); }
  .bf__row { display: flex; flex-wrap: wrap; gap: 8px; }
  .bf__chip {
    min-height: var(--tap);
    padding: 8px 16px;
    font: inherit;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .bf__chip.is-on { color: var(--color-on-brand); background: var(--color-brand); border-color: var(--color-brand); }
  .bf__check { display: flex; align-items: center; gap: 10px; font-size: var(--fs-small); cursor: pointer; }
  .bf__check input { width: 20px; height: 20px; accent-color: var(--color-brand); }
  .bf__count { margin: 0; font-size: var(--fs-tiny); color: var(--color-muted); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-bf]');
  if (root) {
    let brand = '';
    let ceramic = false;
    const count = root.querySelector<HTMLElement>('[data-bf-count]');
    const word = (n: number) => { const a = n % 10, b = n % 100; return a === 1 && b !== 11 ? 'позиция' : a >= 2 && a <= 4 && (b < 12 || b > 14) ? 'позиции' : 'позиций'; };
    const rows = [...document.querySelectorAll<HTMLElement>('[data-pos-item]')];
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      let shown = 0;
      rows.forEach((li) => {
        const ok = (!brand || li.dataset.brand === brand) && (!ceramic || li.dataset.ceramic === '1');
        li.hidden = !ok;
        if (ok) shown++;
      });
      document.querySelectorAll<HTMLElement>('[data-part]').forEach((part) => {
        part.hidden = !part.querySelector('[data-pos-item]:not([hidden])');
      });
      // Показанные фильтром строки видны сразу, не дожидаясь появления при прокрутке (Reveal,
      // [data-reveal-items]): без этого строка снизу списка, поднявшаяся на экран, оставалась прозрачной.
      const late = rows.filter((li) => !li.hidden && !li.classList.contains('is-revealed'));
      late.forEach((li) => { li.style.transition = 'none'; li.classList.add('is-revealed'); });
      if (late.length) requestAnimationFrame(() => requestAnimationFrame(() => late.forEach((li) => { li.style.transition = ''; })));
      if (count) count.textContent = brand || ceramic ? `Показано: ${shown} ${word(shown)}` : '';
    };

    // Плавная смена списка (только строки у экрана, без блокировки кликов): уходящие тают и опускаются
    // на 6 px (копия на старом месте, 200 мс), новые проявляются с подъёмом на 6 px, оставшиеся
    // переезжают на новые места (240 мс). Состояние списка и счётчик меняются сразу.
    const EASE = 'cubic-bezier(0.4, 0, 0.2, 1)';
    const near = (r: DOMRect) => r.bottom > -100 && r.top < window.innerHeight + 100;
    const apply = (animate = false) => {
      if (!animate || !motionOk || !('animate' in Element.prototype)) { update(); return; }
      const before = new Map<HTMLElement, DOMRect>();
      rows.forEach((li) => { if (!li.hidden) { const r = li.getBoundingClientRect(); if (near(r)) before.set(li, r); } });
      update();
      before.forEach((r, li) => {
        if (!li.hidden) return;
        // ушла: копия без id и data-атрибутов (её не находят скрипты и проверки), мимо кликов, ПОД строками
        // (z-index −1): где на её место уже встала другая строка, текст не двоится — копия видна только в пустоте
        const ghost = li.cloneNode(true) as HTMLElement;
        for (const el of [ghost, ...ghost.querySelectorAll<HTMLElement>('[id], [data-pos]')]) { el.removeAttribute('id'); el.removeAttribute('data-pos'); }
        ghost.removeAttribute('data-pos-item');
        ghost.removeAttribute('data-brand');
        ghost.removeAttribute('data-ceramic');
        ghost.hidden = false;
        ghost.setAttribute('aria-hidden', 'true');
        ghost.inert = true;
        Object.assign(ghost.style, { position: 'absolute', left: `${r.left + window.scrollX}px`, top: `${r.top + window.scrollY}px`, width: `${r.width}px`, height: `${r.height}px`, margin: '0', zIndex: '-1', pointerEvents: 'none', transition: 'none' });
        document.body.append(ghost);
        ghost.animate([{ opacity: 1, translate: '0 0' }, { opacity: 0, translate: '0 6px' }], { duration: 200, easing: EASE, fill: 'forwards' }).finished.finally(() => ghost.remove());
      });
      rows.forEach((li) => {
        if (li.hidden) return;
        const r = li.getBoundingClientRect();
        const old = before.get(li);
        if (old) {
          const dy = old.top - r.top;
          if (Math.abs(dy) > 1) li.animate([{ translate: `0 ${dy}px` }, { translate: '0 0' }], { duration: 240, easing: EASE });
        } else if (near(r)) {
          // новая строка или приехавшая из-за края экрана — проявляется
          li.animate([{ opacity: 0, translate: '0 6px' }, { opacity: 1, translate: '0 0' }], { duration: 240, easing: EASE });
        }
      });
    };

    root.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-bf-brand]');
      if (!chip) return;
      brand = chip.dataset.bfBrand || '';
      root.querySelectorAll('[data-bf-brand]').forEach((c) => {
        c.classList.toggle('is-on', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      apply(true);
    });
    const check = root.querySelector<HTMLInputElement>('[data-bf-ceramic]');
    check?.addEventListener('change', () => {
      ceramic = check.checked;
      apply(true);
    });
    // Галочку браузер восстанавливает сам (обновление, «Назад», страница из bfcache), а
    // состояние скрипта начиналось с false: галочка стояла, а список показывал всё.
    // Берём состояние с самой галочки — при запуске и при каждом показе страницы.
    const sync = () => {
      if (!check || check.checked === ceramic) return;
      ceramic = check.checked;
      apply();
    };
    sync();
    window.addEventListener('pageshow', sync);
  }
</script>
