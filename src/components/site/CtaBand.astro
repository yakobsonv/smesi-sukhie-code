---
// Полоса связи внизу страниц: телефон и ссылка на доставку. Заявок через форму пока нет
// (приём заявок не подключаем — слово Влада), поэтому только звонок.
import Container from '../layout/Container.astro';
import { getSite, OFFICES } from '../../lib/sites';
import { PAGES } from '../../data/nav';
interface Props { title?: string; text?: string }
const { title = 'Цена с доставкой и наличие — по телефону', text = 'Назовите смеси и объём — посчитаем стоимость с доставкой по Москве и Московской области.' } = Astro.props;
const site = getSite('sukhie');
---
<section class="cta">
  <Container>
    <div class="cta__in">
      <div>
        <p class="cta__title">{title}</p>
        <p class="cta__text">{text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={site.phone.href}>{site.phone.display}</a>
        <a class="cta__link" href={OFFICES[1].phone.href}>{OFFICES[1].phone.display}</a>
        <a class="cta__link" href={PAGES.dostavka.href}>Условия доставки</a>
      </div>
    </div>
  </Container>
</section>
<style>
  .cta { padding: var(--section-pad-md) 0; background: var(--color-dark); color: var(--color-on-dark); }
  .cta__in { display: grid; gap: var(--space-5); align-items: center; }
  .cta__title { margin: 0 0 var(--space-2); font-family: var(--font-head); font-size: var(--fs-h2); font-weight: 800; line-height: 1.15; }
  .cta__text { max-width: 56ch; margin: 0; color: rgb(255 255 255 / 0.86); }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .cta__link { color: var(--color-brand-on-dark); font-weight: 600; }
  @media (min-width: 900px) { .cta__in { grid-template-columns: minmax(0, 1fr) auto; } }
</style>
